# ============================================================
# Development Environment Configuration
# ============================================================

# Node Environment
NODE_ENV=development

# Development Server
VITE_HOST=localhost
VITE_PORT=5173
VITE_DEV_SERVER_URL=http://localhost:5173

# API Configuration - Development
VITE_API_URL=http://localhost:5000/api
REACT_APP_API_URL=http://localhost:5000/api
VITE_ENV=development
REACT_APP_ENV=development

# API Timeout (development - longer for debugging)
VITE_API_TIMEOUT=30000
REACT_APP_API_TIMEOUT=30000

# Cloudinary Configuration - Development
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
REACT_APP_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=zovio-workers
REACT_APP_CLOUDINARY_UPLOAD_PRESET=zovio-workers

# Feature Flags - Development
REACT_APP_ENABLE_ANALYTICS=true
REACT_APP_ENABLE_EXPORT=true
REACT_APP_ENABLE_BULK_OPERATIONS=true
VITE_ENABLE_DEVTOOLS=true

# Debugging - Development
REACT_APP_DEBUG_MODE=true
REACT_APP_LOG_LEVEL=debug
VITE_LOG_LEVEL=debug
DEBUG=*

# App Configuration
REACT_APP_APP_NAME=Zovio (Development)
REACT_APP_APP_VERSION=1.0.0-dev
REACT_APP_SUPPORT_EMAIL=dev@zovio.com

# Limits and Constraints
VITE_MAX_FILE_SIZE=5242880
REACT_APP_MAX_FILE_SIZE=5242880
REACT_APP_MAX_WORKERS_PER_PAGE=10
REACT_APP_PAGINATION_SIZE=25

# CORS Configuration
VITE_CORS_ENABLED=true
VITE_CORS_ORIGIN=http://localhost:5173

# Source Maps - Development
VITE_SOURCEMAP=true
REACT_APP_SOURCEMAP=true

# Hot Module Replacement (HMR)
VITE_HMR_HOST=localhost
VITE_HMR_PORT=5173
VITE_HMR_PROTOCOL=http

# Google OAuth - Development
VITE_GOOGLE_CLIENT_ID=your-dev-google-client-id
REACT_APP_GOOGLE_CLIENT_ID=your-dev-google-client-id

# Authentication - Development
VITE_AUTH_ENABLED=true
VITE_AUTH_DEBUG=true

# Logging
VITE_ENABLE_CONSOLE_LOGS=true
REACT_APP_ENABLE_CONSOLE_LOGS=true
VITE_ENABLE_NETWORK_LOGS=true
REACT_APP_ENABLE_NETWORK_LOGS=true

# Storage
VITE_STORAGE_TYPE=localStorage
REACT_APP_STORAGE_TYPE=localStorage

# Development Server Options
VITE_STRICT_PORT=false
VITE_OPEN_BROWSER=true

# Development Tools
VITE_ENABLE_REACT_DEVTOOLS=true
VITE_ENABLE_ROUTER_DEVTOOLS=true
